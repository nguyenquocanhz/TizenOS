[Unit]
Description=TizenOS GPU Hotplug Monitor
Documentation=file:///usr/share/doc/tizenos/gpu-management.md
After=tizenos-gpu-detect.service
Requires=tizenos-gpu-detect.service

[Service]
Type=simple
Restart=on-failure
RestartSec=5

# Giám sát thay đổi GPU qua udev monitor
# Khi phát hiện eGPU add/remove → chạy lại detection
ExecStart=/bin/bash -c '\
    exec stdbuf -oL udevadm monitor --subsystem-match=drm --property 2>/dev/null | \
    while read -r line; do \
        if echo "$line" | grep -qE "ACTION=(add|remove)"; then \
            echo "[GPU-MONITOR] GPU hotplug detected, re-running detection..." | \
                systemd-cat -t tizenos-gpu-monitor -p info; \
            sleep 2; \
            /usr/lib/tizenos/gpu/tizenos-gpu-detect.sh; \
            echo "[GPU-MONITOR] Detection updated." | \
                systemd-cat -t tizenos-gpu-monitor -p info; \
        fi; \
    done'

# Bảo mật
ReadWritePaths=/run/tizenos
ProtectHome=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tizenos-gpu-monitor

[Install]
WantedBy=graphical.target
